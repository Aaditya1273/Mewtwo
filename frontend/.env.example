# ─────────────────────────────────────────────────────────────
# ARGUS frontend — environment template
# Copy to .env.local for local development.
# ─────────────────────────────────────────────────────────────

# ARGUS Go backend base URL.
#
#   ARGUS_BACKEND_URL              → read by server-side code (API route
#                                    proxies + next.config rewrites) at runtime.
#   NEXT_PUBLIC_ARGUS_BACKEND_URL  → inlined into the client bundle at BUILD
#                                    time (WebSockets, MCP deep links, and any
#                                    URL rendered in the browser).
#
# Set both to the same value. When unset, they default to the hosted Render
# backend (https://argus-xhgx.onrender.com) so existing deployments keep
# working. Self-hosters should set them to their own backend, e.g.:
#   http://localhost:8080          (local dev)
#   http://argus-control-plane:8080 (inside docker-compose)
#   https://argus.example.com      (production)
ARGUS_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_ARGUS_BACKEND_URL=http://localhost:8080

# NextAuth (Google OAuth) — required for /login and the dashboard session
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=<openssl rand -base64 32>
# AUTH_TRUST_HOST=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Postgres (NextAuth Prisma adapter) — required for login persistence
# DATABASE_URL=postgresql://user:password@host:5432/argus
