# ATTEST engine configuration. Copy to .env (never commit .env) and export before running:
#   set -a; . ./.env; set +a; uv run python -m attest.app

# DEVELOPMENT MODE bypasses Seeker Genesis Token eligibility and labels every receipt as such.
# Leave false for anything that claims real verification.
ATTEST_DEV_MODE=false

# Domain placed in the SIWS message the wallet signs.
ATTEST_DOMAIN=presence.local
ATTEST_HOST=0.0.0.0
ATTEST_PORT=8787
ATTEST_DB=./attest.db
ATTEST_SESSION_TTL_SECONDS=300

# SGT checks always run against mainnet (SGTs do not exist on devnet). Use a paid RPC in production.
SGT_RPC_URL=https://api.mainnet-beta.solana.com

# Where DailyAttestation is written: localnet | devnet | mainnet
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=CFZsFPtvwo5KDenV3qgorroaRmT7NuYsfPnd4avFS2cT
# Path to the attestor keypair JSON (pays rent, signs record_attestation). Keep it out of the repo.
# Leave empty to run without on-chain settlement (receipts then say NOT_CONFIGURED).
ATTESTOR_KEYPAIR=
# Optional: SPL mint used to pay each mission's "reward.token" amount.
REWARD_MINT=
REWARD_DECIMALS=6
# Rewards are TRANSFERRED from the attestor's pool account (its ATA for REWARD_MINT), never minted.
# Devnet: scripts/devnet_setup.sh creates an SKR_TEST mint (6 decimals). Receipts label it SKR-TEST off mainnet.
# Mainnet SKR (classic SPL Token, 6 decimals; CA from solanamobile.com):
#   REWARD_MINT=SKRbvo6Gf7GondiT3BbTfuRDPqLWei4j2Qy2NPGZhW3
# Sponsors fund a mission by transferring REWARD_MINT to the pool, then POST /sponsor/deposit {mission_id, signature}.
