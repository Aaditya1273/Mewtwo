{
  "name": "linger-scene",
  "version": "0.1.0",
  "description": "LINGER \u2014 The Presence Protocol. Decentraland SDK7 scene.",
  "scripts": {
    "start": "sdk-commands start --web3",
    "deploy": "npm run config:check && sdk-commands build --production && sdk-commands deploy --target-content https://worlds-content-server.decentraland.org",
    "build": "sdk-commands build",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "configure": "node scripts/configure-world.js --write",
    "config:check": "node scripts/configure-world.js --check",
    "build:prod": "sdk-commands build --production"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.27.0",
    "@dcl/sdk": "7.27.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  },
  "dependencies": {
    "@dcl-sdk/utils": "^1.1.1",
    "colyseus.js": "^0.14.15-alpha.0"
  },
  "bundleDependencies": [
    "colyseus.js"
  ],
  "license": "Apache-2.0"
}
