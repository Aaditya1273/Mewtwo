# ------------------------------------------------------------------
# ARGUS - environment template
# Copy to .env.local / export in the backend environment.
# ------------------------------------------------------------------

# Core
ARGUS_BUDGET_LIMIT=100.0

# DataHub metadata-aware governance (optional)
# ARGUS acts as an MCP *client* to the DataHub MCP Server. When both
# DATAHUB_MCP_URL and DATAHUB_TOKEN are set, every MCP tool call is
# evaluated against DataHub metadata (ownership, lineage PII, policies,
# data quality, deprecation) BEFORE execution. Without them, the
# integration is a no-op and ARGUS behaves exactly as before.
#
#   DATAHUB_MCP_URL=https://<tenant>.acryl.io/integrations/ai/mcp
#   DATAHUB_TOKEN=<datahub personal access token>
#   DATAHUB_MUTATION_ENABLED=true   # enables audit write-back (add_tags etc.)
#   DATAHUB_HTTP_TIMEOUT=15s        # optional client timeout
#
# Server-side (set on the DataHub MCP server, NOT ARGUS):
#   TOOLS_IS_MUTATION_ENABLED=true      # enables add_tags/remove_tags/add_owners/set_domains/update_description
#   TOOLS_IS_USER_ENABLED=true          # enables get_me
#   DATA_QUALITY_TOOLS_ENABLED=true     # enables get_dataset_assertions

# SigNoz Cloud telemetry (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<key>

# Frontend (Next.js / NextAuth)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=<openssl rand -base64 32>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DATABASE_URL=<supabase postgres connection string>
# AUTH_TRUST_HOST=true
