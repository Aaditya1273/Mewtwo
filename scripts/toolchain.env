# Source this to put the user-local toolchains used by PRESENCE on PATH (no system changes).
#   . scripts/toolchain.env
export JAVA_HOME="$(ls -d "$HOME"/.local/share/jdk/jdk-17* 2>/dev/null | head -1)"
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Android/Sdk}"
export RUSTUP_HOME="$HOME/.local/share/solana-rustup/rustup"
export CARGO_HOME="$HOME/.local/share/solana-rustup/cargo"
export PATH="$CARGO_HOME/bin:$HOME/.local/share/solana/install/active_release/bin:$HOME/.avm/bin:$JAVA_HOME/bin:$ANDROID_HOME/platform-tools:$PATH"
